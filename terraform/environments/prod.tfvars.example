# ==============================================================================
# Production Environment Configuration (EXAMPLE)
# ==============================================================================

# General
region      = "us-east-1"
aws_profile = "your-prod-profile"
environment = "prod"

# Network - Use your production VPC and private subnets
vpc_id  = "vpc-xxxxxxxx"
subnets = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]

# Existing PostgreSQL (do not create Aurora in prod)
create_aurora_cluster      = false
existing_db_host           = "postgres-aurora-prod.cluster-ch7yo6tzxi4l.us-east-1.rds.amazonaws.com"
existing_db_name           = "postgres"
existing_db_port           = 5432
existing_db_security_group_id = "sg-xxxxxxxx"

# Lambda DB credentials (prefer runtime secret resolution)
master_username = "alert_db"
master_password = ""
db_secret_id    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:rag-agents/prod/postgres-xxxxx"

# S3
enable_s3_cors       = false
cors_allowed_origins = []

# Bedrock Models
embeddings_model   = "cohere.embed-v4:0"
main_llm_model     = "anthropic.claude-3-5-sonnet-20241022-v2:0"
fallback_llm_model = "anthropic.claude-3-haiku-20240307-v1:0"
output_tokens      = "4096"

# Opcional: API HTTP /query valida JWT contra un User Pool existente (p. ej. clientes/productivos).
# Si no se define, se usa pool+client que crea el módulo cognito_query del proyecto.
#
# rag_query_api_cognito_user_pool_id = "us-east-1_xxxxxxxx"
# rag_query_api_cognito_client_id    = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
